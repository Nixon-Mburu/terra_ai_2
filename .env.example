# Terra AI — Environment Variables Template
# Copy this file to .env and fill in your API keys

# ── Frontend (exposed to browser via Vite) ──────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Backend (Flask / Python) ─────────────────────────────────────────────────

# Required for elevation, reverse geocoding, places, and map tiles
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required for Gemini risk synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — required only for JRC flood history via Google Earth Engine REST
# If unset, flood_history will gracefully return False
GOOGLE_EARTH_ENGINE_API_KEY=your_gee_api_key_here

# Flask server port (default: 5000)
PORT=5000
