# Terra AI Backend — Environment Variables
# Copy this file to .env and fill in your keys

# Required for Gemini risk synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Required for elevation, reverse geocoding, places, and map tiles
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional — required only for JRC flood history via Google Earth Engine REST
# If unset, flood_history will always be False (graceful fallback)
GOOGLE_EARTH_ENGINE_API_KEY=your_gee_api_key_here
